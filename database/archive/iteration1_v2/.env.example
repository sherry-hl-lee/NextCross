# Environment-variable template for local Iteration 1 v2 database commands.
# Copy this file to .env.neon, replace every placeholder locally, and never
# commit or share the populated file. The repository .gitignore excludes it.

# Use the Neon Direct (non-pooler) owner URL only for schema migration and bulk
# road-speed replacement. Both operations require TLS and channel binding.
DATABASE_URL='postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# After creating a SELECT-only backend role, use its pooled URL for GPS lookups.
# Keep owner credentials out of the backend and Android application.
# RUNTIME_DATABASE_URL='postgresql://READER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
